{
  "name": "sentinel-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "build:frontend": "node scripts/build-frontend.js",
    "test": "node --test tests/*.test.js",
    "eval": "node scripts/evaluate.js",
    "eval:pdf-fixture": "node scripts/evaluate-pdf-fixture.js",
    "eval:northwind": "node scripts/evaluate-northwind-unseen.js",
    "db:migrate": "node scripts/migrate.js",
    "model:download": "node scripts/download-model.js",
    "ocr:download": "node scripts/download-tessdata.js",
    "eval:zerogpu-baseline": "node scripts/zerogpu-baseline.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "pg": "8.16.3",
    "sharp": "0.35.5",
    "tesseract.js": "7.0.0"
  },
  "overrides": {
    "mammoth": {
      "argparse": "3.0.3"
    },
    "uuid": "11.1.1"
  }
}
