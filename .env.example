HOST=0.0.0.0
PORT=10000
NODE_ENV=production
PUBLIC_API_BASE_URL=https://api.example.com/api/v1
CORS_ORIGINS=https://sentinel.example.com
DATABASE_URL=
# Set true in production; the process must not accept scans without migrated PostgreSQL.
REQUIRE_DATABASE=true
# Set true in production; readiness and scans fail if local inference cannot initialize.
REQUIRE_LOCAL_CLASSIFIER=true
# Render internal Postgres URL: disable TLS on its private network. For external URLs use require.
DATABASE_SSL=disable
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_QUERY_TIMEOUT_MS=5000
MAX_UPLOAD_BYTES=5242880
MAX_TEXT_BYTES=1048576
MAX_PROCESSING_MS=20000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_REQUESTS=30
MAX_CONCURRENT_SCANS=1
TRUST_PROXY=true
SESSION_REPORT_TTL_MS=900000
MAX_SESSION_REPORTS=50
PUBLIC_DEMO_MODE=false
TESSERACT_LANG_PATH=/var/data/tessdata
TESSERACT_LANG=eng
SENTINEL_MODEL_DIR=/var/data/sentinel-deberta-v3-prompt-injection-v2
SENTINEL_ML_THRESHOLD=0.5
SENTINEL_ML_MAX_CHUNKS=256
SENTINEL_ML_TIMEOUT_MS=120000
# Optional ZeroGPU inference adapter. Keep the token in Render's secret environment only.
# Both are required; without them, PUBLIC_DEMO_MODE remains the rules-only fallback.
# HF_SPACE_URL=https://<namespace>-<space-name>.hf.space
# HF_TOKEN=<fine-grained read token for that private Space>
# Optional constrained free-demo parser-worker caps (only when testing a 512 MB service)
PARSER_OLD_HEAP_MB=192
PARSER_YOUNG_HEAP_MB=32
